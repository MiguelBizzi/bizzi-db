# No secrets are required to run the desktop client.
# PostgreSQL credentials are entered in the connection modal and stored in the OS keychain.
#
# Local mock database (bun run db:up / docker compose up -d --wait):
#   Host:     127.0.0.1
#   Port:     5433
#   User:     postgres
#   Password: postgres
#   Database: postgres
#   SSL:      off
#
# Override the host port if 5433 is taken: DB_PORT=5434 bun run db:up
