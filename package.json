{
  "name": "db-manager",
  "private": true,
  "version": "0.1.24",
  "packageManager": "bun@1.3.11",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev --filter=desktop",
    "dev:web": "turbo run dev --filter=web",
    "build": "turbo run build",
    "changelog:generate": "bun apps/web/scripts/generate-changelog.ts",
    "lint": "turbo run lint",
    "test": "turbo run test && cargo test --workspace --exclude db-desktop --locked",
    "test:watch": "bun test --watch",
    "test:all": "bun run db:up && turbo run test && cargo test --workspace --exclude db-desktop --locked -- --include-ignored",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait"
  },
  "devDependencies": {
    "turbo": "^2.11.9",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.5",
    "@lezer/lr": "1.4.10",
    "@tauri-apps/api": "2.2.0",
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2"
  }
}
